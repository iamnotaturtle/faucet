{
  "name": "faucet",
  "version": "1.0.0",
  "description": "Deploy your ERC20 contract and interact with it",
  "type": "module",
  "scripts": {
    "compile-contract": "node scripts/compile-contract.js",
    "verify-contract": "node scripts/verify-contract.js",
    "dev": "vite",
